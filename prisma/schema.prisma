// Crexup — AI Influencer Marketing Platform
// Prisma schema (PostgreSQL)

generator client { provider = "prisma-client-js" output = "../src/generated/prisma" }


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ADMIN (only login in Phase 1)
// ============================================================

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  CAMPAIGN_MANAGER
  SUPPORT
}

model Admin {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         AdminRole  @default(ADMIN)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  notes             CreatorNote[]
  activityLogs      ActivityLog[]
  campaignsCreated  Campaign[]        @relation("CampaignCreatedBy")
  whatsappMessages  WhatsappMessage[] @relation("WhatsappSentBy")
  contentReviews    ContentSubmission[] @relation("ContentReviewedBy")
  creatorRatingsGiven CreatorRating[]

  @@map("admins")
}

model ActivityLog {
  id        String   @id @default(cuid())
  admin     Admin    @relation(fields: [adminId], references: [id])
  adminId   String
  action    String // e.g. "CREATOR_UPDATED", "CAMPAIGN_CREATED", "MESSAGE_SENT"
  entityType String
  entityId   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@map("activity_logs")
}

// ============================================================
// CREATORS
// ============================================================

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
  ON_CAMPAIGN
  UNAVAILABLE
}

enum CollaborationStatus {
  NEW
  CONTACTED
  IN_TALKS
  ACTIVE
  DORMANT
  BLACKLISTED
}

enum AccountType {
  PERSONAL
  CREATOR
  BUSINESS
}

model Creator {
  id               String   @id @default(cuid())
  creatorCode      String   @unique // human-friendly Creator ID, e.g. CRX-000123
  fullName         String
  instagramUsername String  @unique
  instagramUrl     String?
  mobileNumber     String
  whatsappNumber   String
  email            String
  gender           Gender?
  state            String
  city             String
  language         String
  contentCategory  String
  contentNiche     String
  upiId            String?

  verificationStatus   VerificationStatus  @default(UNVERIFIED)
  availabilityStatus   AvailabilityStatus  @default(AVAILABLE)
  collaborationStatus  CollaborationStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instagramProfile InstagramProfile?
  scores           CreatorScore?
  performance      CreatorPerformance?
  rating           CreatorRating?
  notes            CreatorNote[]
  documents        CreatorDocument[]

  campaignCreators     CampaignCreator[]
  whatsappMessages     WhatsappMessage[]
  contentSubmissions   ContentSubmission[]
  shipments            Shipment[]

  @@index([state, city])
  @@index([contentCategory, contentNiche])
  @@index([fullName])
  @@map("creators")
}

model CreatorDocument {
  id        String   @id @default(cuid())
  creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId String
  label     String
  fileUrl   String
  uploadedAt DateTime @default(now())

  @@map("creator_documents")
}

// ============================================================
// INSTAGRAM DATA (auto-fetched via Graph API, or manually entered)
// ============================================================

model InstagramProfile {
  id        String  @id @default(cuid())
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId String  @unique

  profilePictureUrl String?
  bio               String?
  followers         Int      @default(0)
  following         Int      @default(0)
  totalPosts        Int      @default(0)

  avgReelViews    Float @default(0)
  avgLikes        Float @default(0)
  avgComments     Float @default(0)
  engagementRate  Float @default(0) // percentage
  postingFrequency Float @default(0) // posts per week

  accountType         AccountType @default(PERSONAL)
  verificationBadge   Boolean     @default(false) // Instagram blue check

  audienceCountry  Json? // { "India": 72.5, "USA": 10.2, ... }
  audienceCity     Json?
  audienceGender   Json? // { "male": 40, "female": 58, "other": 2 }
  audienceAge      Json? // { "18-24": 35, "25-34": 40, ... }
  audienceInterests Json?

  dataSource     String   @default("MANUAL") // "GRAPH_API" | "MANUAL" | "MIXED"
  lastFetchedAt  DateTime?
  isStale        Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("instagram_profiles")
}

// ============================================================
// AI SCORING
// ============================================================

model CreatorScore {
  id        String  @id @default(cuid())
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId String  @unique

  creatorScore          Float @default(0) // 0-100 composite
  engagementScore       Float @default(0)
  consistencyScore      Float @default(0)
  audienceQualityScore  Float @default(0)
  reliabilityScore      Float @default(0)
  fakeFollowerRisk      Float @default(0) // 0-100, higher = riskier
  brandFriendlyScore    Float @default(0)
  growthScore           Float @default(0)

  recommendationTier String? // "HIGHLY_RECOMMENDED" | "RECOMMENDED" | "GOOD_CHOICE" | "REVIEW" | "NOT_RECOMMENDED"

  calculatedAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("creator_scores")
}

// ============================================================
// CREATOR PERFORMANCE (rolled up from completed campaigns)
// ============================================================

model CreatorPerformance {
  id        String  @id @default(cuid())
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId String  @unique

  totalCampaigns      Int   @default(0)
  avgViews            Float @default(0)
  avgReach            Float @default(0)
  avgEngagement       Float @default(0)
  avgSaves            Float @default(0)
  avgShares           Float @default(0)

  completionRate      Float @default(0) // %
  onTimeDeliveryRate  Float @default(0) // %
  acceptanceRate      Float @default(0) // %

  brandRatingAvg      Float @default(0) // 0-5
  adminRatingAvg      Float @default(0) // 0-5
  avgPerformanceScore Float @default(0)

  updatedAt DateTime @updatedAt

  @@map("creator_performance")
}

// ============================================================
// CREATOR RATING (manual, admin-entered "Creator Score" card —
// distinct from the AI-computed CreatorScore above)
// ============================================================

enum ReliabilityRating {
  EXCELLENT
  GOOD
  AVERAGE
  POOR
}

model CreatorRating {
  id        String  @id @default(cuid())
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId String  @unique

  contentQuality      Int @default(0) // 0-5 stars
  communication       Int @default(0) // 0-5 stars
  onTimeDelivery      Int @default(0) // 0-5 stars
  campaignPerformance Int @default(0) // 0-5 stars
  brandFit            Int @default(0) // 0-5 stars

  overallScore Float             @default(0) // 0-10, auto-averaged from the 5 stars above
  reliability  ReliabilityRating @default(AVERAGE)
  description  String? // free-text admin review

  lastReviewedAt DateTime  @default(now())
  lastReviewedBy Admin?    @relation(fields: [lastReviewedById], references: [id])
  lastReviewedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("creator_ratings")
}

// ============================================================
// CREATOR NOTES (internal, positive/negative)
// ============================================================

enum NoteCategory {
  POSITIVE
  NEGATIVE
}

model CreatorNote {
  id        String       @id @default(cuid())
  creator   Creator      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId String
  admin     Admin        @relation(fields: [adminId], references: [id])
  adminId   String
  campaign  Campaign?    @relation(fields: [campaignId], references: [id])
  campaignId String?
  category  NoteCategory
  text      String
  createdAt DateTime     @default(now())

  @@index([creatorId])
  @@map("creator_notes")
}

// ============================================================
// CAMPAIGNS
// ============================================================

enum CampaignStage {
  DRAFT
  CREATOR_SHORTLISTED
  INVITATION_SENT
  CREATOR_ACCEPTED
  ADDRESS_SUBMITTED
  PRODUCT_SHIPPED
  DELIVERED
  CONTENT_SUBMITTED
  REVISION_REQUIRED
  APPROVED
  POSTED
  COMPLETED
  CANCELLED
}

model Campaign {
  id            String   @id @default(cuid())
  campaignCode  String   @unique // e.g. CMP-000045
  name          String
  brandName     String
  product       String
  goal          String?
  budget         Float?
  productValue   Float?
  creatorPayment Float?
  deliverables   String?
  deadline       DateTime?
  hashtags       String[] @default([])
  captionGuidelines String?
  contentGuidelines String?
  referenceVideoUrls String[] @default([])

  stage         CampaignStage @default(DRAFT)

  createdBy     Admin    @relation("CampaignCreatedBy", fields: [createdById], references: [id])
  createdById   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creators           CampaignCreator[]
  whatsappMessages   WhatsappMessage[]
  contentSubmissions ContentSubmission[]
  shipments          Shipment[]
  performance        CampaignPerformance[]
  notes              CreatorNote[]

  @@map("campaigns")
}

// Join table: which creators are part of which campaign, with per-creator pipeline state
enum CreatorCampaignStatus {
  SHORTLISTED
  INVITED
  ACCEPTED
  DECLINED
  ADDRESS_SUBMITTED
  SHIPPED
  DELIVERED
  CONTENT_SUBMITTED
  REVISION_REQUESTED
  APPROVED
  POSTED
  COMPLETED
  REMOVED
}

model CampaignCreator {
  id         String   @id @default(cuid())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String
  creator    Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId  String

  status CreatorCampaignStatus @default(SHORTLISTED)

  // Recommendation snapshot at time of shortlisting
  recommendationScore Float?
  recommendationTier  String?

  // Confirmation form fields
  shippingCity     String?
  shippingState    String?
  shippingPincode  String?
  shippingUpi      String?
  shippingPhone    String?
  termsAcceptedAt  DateTime?

  brandRating  Float? // 0-5, set post-campaign
  adminRating  Float? // 0-5, set post-campaign

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, creatorId])
  @@map("campaign_creators")
}

// ============================================================
// WHATSAPP
// ============================================================

enum WhatsappStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  REPLIED
  ACCEPTED
  DECLINED
  FAILED
  PENDING
}

model WhatsappMessage {
  id         String   @id @default(cuid())
  creator    Creator  @relation(fields: [creatorId], references: [id])
  creatorId  String
  campaign   Campaign? @relation(fields: [campaignId], references: [id])
  campaignId String?

  messageText String
  status      WhatsappStatus @default(QUEUED)
  providerMessageId String? // WhatsApp Business API message id

  sentBy    Admin?  @relation("WhatsappSentBy", fields: [sentById], references: [id])
  sentById  String?

  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  repliedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
  @@index([campaignId])
  @@map("whatsapp_messages")
}

// ============================================================
// SHIPPING
// ============================================================

enum ShippingStatus {
  PENDING
  PACKED
  SHIPPED
  IN_TRANSIT
  DELIVERED
  RETURNED
  FAILED
}

model Shipment {
  id         String   @id @default(cuid())
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  campaignId String
  creator    Creator  @relation(fields: [creatorId], references: [id])
  creatorId  String

  product       String
  courier       String?
  trackingNumber String?
  status        ShippingStatus @default(PENDING)
  shippedAt     DateTime?
  deliveredAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("shipments")
}

// ============================================================
// CONTENT SUBMISSION
// ============================================================

enum ContentReviewStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

model ContentSubmission {
  id         String   @id @default(cuid())
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  campaignId String
  creator    Creator  @relation(fields: [creatorId], references: [id])
  creatorId  String

  reelLink     String?
  storyLink    String?
  postingDate  DateTime?
  caption      String?
  screenshotUrl String?

  reviewStatus ContentReviewStatus @default(PENDING_REVIEW)
  reviewComment String?
  reviewedBy   Admin? @relation("ContentReviewedBy", fields: [reviewedById], references: [id])
  reviewedById String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("content_submissions")
}

// ============================================================
// BRAND INQUIRIES (public form; brands never get direct creator access)
// ============================================================

enum InquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  CLOSED
}

model BrandInquiry {
  id           String        @id @default(cuid())
  brandName    String
  contactName  String
  email        String
  phone        String
  budget       String?
  campaignGoal String?
  message      String?
  status       InquiryStatus @default(NEW)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("brand_inquiries")
}

// ============================================================
// CAMPAIGN PERFORMANCE (per creator, per campaign — rolls up to CreatorPerformance)
// ============================================================

model CampaignPerformance {
  id         String   @id @default(cuid())
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  campaignId String
  creatorId  String // denormalized for fast rollups; not a hard FK to allow historical retention

  reelViews     Int   @default(0)
  reach         Int   @default(0)
  likes         Int   @default(0)
  comments      Int   @default(0)
  shares        Int   @default(0)
  saves         Int   @default(0)
  profileVisits Int   @default(0)
  websiteClicks Int   @default(0)
  storyViews    Int   @default(0)
  linkClicks    Int   @default(0)

  cpv Float? // cost per view
  cpe Float? // cost per engagement
  engagementRate Float?

  dataSource String @default("MANUAL") // "MANUAL" | "IMPORTED"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([creatorId])
  @@map("campaign_performance")
}
