DATABASE_URL="postgresql://user:password@localhost:5432/crexup?schema=public"
PORT=4000
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Instagram Graph API (leave blank to use mock data)
INSTAGRAM_GRAPH_API_TOKEN=""
INSTAGRAM_GRAPH_API_BASE_URL="https://graph.facebook.com/v19.0"
USE_MOCK_INSTAGRAM="true"

# WhatsApp Business API (leave blank to use mock/logging-only sender)
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_BASE_URL="https://graph.facebook.com/v19.0"
USE_MOCK_WHATSAPP="true"

# Supabase Storage (for documents, screenshots, profile pictures)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="crexup-uploads"
